{
  "name": "projector",
  "version": "0.1.0",
  "type": "module",
  "description": "Canvas 2D 3D rendering and physics simulation library",
  "module": "./dist/projector.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/projector.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demos": "vite build --mode demos",
    "preview": "vite preview --mode demos",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisDrae/Projector.git"
  },
  "keywords": [
    "canvas",
    "3d",
    "physics",
    "simulation",
    "particles"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ChrisDrae/Projector/issues"
  },
  "homepage": "https://github.com/ChrisDrae/Projector#readme",
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.5"
  }
}
