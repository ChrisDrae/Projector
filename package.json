{
  "name": "projector",
  "version": "0.2.0",
  "type": "module",
  "description": "A TypeScript framework for 3D physics simulations on the Canvas 2D API: particles, rigid bodies, lights, shadows",
  "module": "./dist/projector.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/projector.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "build:demos": "vite build --mode demos",
    "preview": "vite preview --mode demos",
    "typecheck": "tsc -p tsconfig.json && tsc -p perf/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "perf": "vitest run --config vitest.perf.config.mts",
    "perf:baseline": "vitest run --config vitest.perf.config.mts --mode baseline",
    "perf:rebaseline": "vitest run --config vitest.perf.config.mts --mode rebaseline"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisDrae/Projector.git"
  },
  "keywords": [
    "canvas",
    "3d",
    "physics",
    "rigid-body",
    "particles",
    "simulation",
    "lighting",
    "game"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ChrisDrae/Projector/issues"
  },
  "homepage": "https://github.com/ChrisDrae/Projector#readme",
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.5"
  }
}
